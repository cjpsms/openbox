TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
SLIPOK_API_KEY=your-slipok-api-key
SLIPOK_API_URL=https://api.slipok.com/api/line/apikey/<your-id>
COURIER_BOT_TOKEN=your-courier-bot-token-from-botfather

# --- openbox-api ---
# Standalone backend (DB + HTTP API + cameras + STM32 link — one process,
# see openbox-api/README.md). Set OPENBOX_API_BASE in each bot's
# environment if the api runs somewhere other than 127.0.0.1:4002 (e.g.
# once it moves onto the RPi and the bots stay on home-server).
OPENBOX_API_HOST=127.0.0.1
OPENBOX_API_PORT=4002

# Claude vision backend: "cli" (default, uses the local `claude` CLI /
# this machine's subscription, no key needed) or "api" (direct Anthropic
# API call, cheaper per-call — needs ANTHROPIC_API_KEY below).
VISION_BACKEND=cli
ANTHROPIC_API_KEY=your-anthropic-api-key
VISION_MODEL=claude-opus-5

# Cameras: -1 disables that camera. Dev machine has one webcam (CAM1=0),
# CAM2 (scanner) is off until a second camera is available.
CAM1_INDEX=0
CAM2_INDEX=-1
CAM1_MOTION_ENABLED=1
SCANNER_LED_PIN=18

# STM32 serial link — leave STM32_SERIAL_PORT empty to run fully
# simulated (no firmware yet). Once the STM32 exists, set e.g.
# STM32_SERIAL_PORT=/dev/ttyUSB0
STM32_SERIAL_PORT=
STM32_BAUD=115200

# Business rules
BOX_RENT_SMALL_THB=20
BOX_RENT_LARGE_THB=35
DROP_SESSION_TTL_SECONDS=300
RIDER_ALLOWED_COMPANIES=Shopee Xpress,Flash Express,Kerry Express,J&T Express,Lalamove,Grab,ไปรษณีย์ไทย
